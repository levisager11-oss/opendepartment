{
  "name": "opendepartment",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:schema": "node scripts/build-schema.mjs",
    "predev": "npm run build:schema",
    "dev": "next dev",
    "prebuild": "npm run build:schema",
    "build": "next build",
    "start": "next start",
    "typecheck": "npm run build:schema && tsc --noEmit",
    "test": "vitest run && npm run test:rls && npm run test:seed",
    "test:unit": "vitest run",
    "test:rls": "node db/test/run.mjs",
    "test:rls:native": "bash db/test/run.sh",
    "test:seed": "node db/test/seed-smoke.mjs",
    "test:smoke": "node tests/http-smoke.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "@vercel/analytics": "^2.0.1",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
