# ---------------------------------------------------------------------------
# OPENDEPARTMENT - environment configuration
# Copy to .env.local and fill in. Never commit .env.local.
#
# Note what is NOT here: any tenant credentials, and any service_role key.
# Departments supply their own Supabase URL and anon key at setup time and
# those live as rows in the control-plane database, not in the environment.
# ---------------------------------------------------------------------------

# --- Control plane: OpenDepartment's OWN Supabase project ------------------
# This project holds the slug -> department directory and operator accounts.
# It never holds department content, so it stays tiny and free indefinitely.
# Run db/control-plane.sql in it once.
NEXT_PUBLIC_CONTROL_SUPABASE_URL=
NEXT_PUBLIC_CONTROL_SUPABASE_ANON_KEY=

# --- PINNED DEPARTMENTS -----------------------------------------------------
# Skips the control plane entirely so you can test a department locally
# without spending a second Supabase project on the directory.
#
# Point it at any project that has db/tenant-schema.sql installed; the slug
# then resolves straight to it and /d/<slug> works with no wizard, no account
# and no NEXT_PUBLIC_CONTROL_* values at all.
#
# One line, JSON, multiple departments allowed:
# STATIC_DEPARTMENTS={"test":{"url":"https://abc.supabase.co","key":"eyJhbGci...","name":"The Test Files"}}
#
# Works in production too: this is the deployment shape for running a single
# archive with no platform around it. Consulted only AFTER the directory, so a
# pin can never shadow a department somebody registered through the wizard.
STATIC_DEPARTMENTS=

# --- Public base URL -------------------------------------------------------
# LOCAL: http://localhost:3000
#
# PRODUCTION: leave UNSET in Vercel. The app derives the origin from the
# incoming request, so production and every preview deployment each tell
# department owners to whitelist their own callback URL. Setting it would pin
# every preview to one fixed domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Canonical URL for SEO -------------------------------------------------
# The single address search engines should index, used for <link rel=canonical>,
# robots.txt and sitemap.xml. Unlike NEXT_PUBLIC_SITE_URL above this must NOT
# vary per deployment: previews point their canonicals at production on purpose,
# so a preview never competes with production for the same keywords.
#
# Defaults to https://opendepartment.vercel.app. Set it when a custom domain is
# attached, in production only.
NEXT_PUBLIC_CANONICAL_URL=

# --- Contact address for abuse reports and takedown requests ---------------
NEXT_PUBLIC_CONTACT_EMAIL=notausgang09@gmail.com

# --- Legal notice / imprint for OpenDepartment itself ----------------------
# The platform operator, distinct from any department's own operator.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_COUNTRY=
